---
/**
 * Edit Nomor Surat — `/surat-keluar/edit/{id}`.
 *
 * Sumber: sinos/application/views/surat_keluar/edit.php +
 * Surat_keluar::edit()/update(). Data: `GET /surat-keluar/{id}`.
 *
 * Ringkasan nomor di atas form adalah konteks baca-saja, sama seperti
 * `edit.php:9-17`: nomor lengkap + badge `no_urut + huruf`. Nomor TIDAK
 * dihitung di klien — nilainya datang dari detail API dan server menyusun
 * ulang `no` saat PUT.
 *
 * Update dikirim sebagai POST + `_method=PUT` (form action route
 * `/api/surat-keluar/{id}`), karena PHP tidak mengisi `$_FILES` pada PUT.
 * `no_urut` dan `huruf` tidak pernah dikirim; server mempertahankannya.
 *
 * Field tanggal dirender di sini (di bawah partial), persis seperti
 * edit.php:21-27.
 */
import AppShell from "../../../layouts/AppShell.astro";
import PageHead from "../../../components/PageHead.astro";
import NomorFields from "../../../components/NomorFields.astro";
import Field from "../../../components/Field.astro";
import FeedbackAlert from "../../../components/FeedbackAlert.astro";
import Icon from "../../../components/Icon.astro";
import NotFoundState from "../../../components/NotFoundState.astro";
import { requireUser } from "../../../lib/auth";
import { apiFetch } from "../../../lib/api";
import { getSession } from "../../../lib/session";
import { takeFormFeedback } from "../../../lib/formFeedback";
import { currentYear } from "../../../lib/format";
import type {
	Klasifikasi,
	PenandatanganGrup,
	Pengambil,
	SuratKeluarDetail,
} from "../../../lib/suratKeluar";

const auth = await requireUser(Astro);
if (auth.redirect) return auth.redirect;
const user = auth.user;
const token = getSession(Astro.cookies);

const id = Number(Astro.params.id);
const idValid = Number.isInteger(id) && id > 0;

const result = idValid
	? await apiFetch<SuratKeluarDetail>(`/surat-keluar/${id}`, { token })
	: null;

/**
 * Dua kegagalan yang harus TERBACA, bukan redirect:
 *   404 — nomor tidak ada (`Surat_keluar::edit()` memakai `show_404()`);
 *   403 — bukan admin dan bukan pemilik (`boleh_ubah()`), pesan API dipakai
 *         apa adanya: "Anda tidak berhak mengubah nomor surat ini."
 */
const notFound = !result?.ok || !result.data;
const detail = (result?.data ?? null) as SuratKeluarDetail;
const forbidden = !notFound && !detail.aksi.can_edit;

if (notFound) Astro.response.status = 404;
else if (forbidden) Astro.response.status = 403;

const tahun =
	Number(String(detail?.tanggal?.iso ?? "").slice(0, 4)) || currentYear();

const [pengambilRes, penandatanganRes, klasifikasiRes] = await Promise.all([
	apiFetch<Pengambil[]>("/master/pengambil", { token }),
	apiFetch<PenandatanganGrup[]>("/master/penandatangan", { token }),
	apiFetch<Klasifikasi[]>("/master/klasifikasi", { token }),
]);

const pengambil = pengambilRes.data ?? [];
const penandatangan = penandatanganRes.data ?? [];
const klasifikasi = klasifikasiRes.data ?? [];

const dashboard = await apiFetch<{ disposisi_belum_dibaca: number }>(
	"/dashboard",
	{ token, query: { tahun } },
);
const disposisiCount = dashboard.data?.disposisi_belum_dibaca ?? 0;

const feedback = takeFormFeedback(Astro.cookies, Astro.url.pathname);

/**
 * Nilai form: detail API sebagai dasar, lalu nilai yang sempat dikirim
 * (feedback.values) menimpanya agar pengguna tidak mengetik ulang.
 */
const nilai: Record<string, string> = notFound
	? {}
	: {
			nip: detail.nip,
			penandatangan_nip: detail.penandatangan_nip,
			kode_penetapan: detail.kode_penetapan || "-",
			ks: detail.kode,
			hal: detail.hal,
			tujuan: detail.tujuan,
		};

if (feedback?.values) {
	for (const [key, value] of Object.entries(feedback.values)) {
		if (typeof value === "string" && key !== "_method" && key !== "tanggal") {
			nilai[key] = value;
		}
	}
}

const tanggalValue =
	typeof feedback?.values?.tanggal === "string"
		? feedback.values.tanggal
		: (detail?.tanggal?.iso ?? "");

const badgeNomor = notFound
	? ""
	: `${detail.no_urut}${detail.huruf ? detail.huruf : ""}`;
---

<AppShell
	title="Edit Nomor Surat"
	user={user}
	disposisiCount={disposisiCount}
	tahun={tahun}
	topbarTitle={false}
>
	{
		notFound ? (
			<NotFoundState
				title="Nomor surat tidak ditemukan"
				description={`Nomor surat dengan ID ${Astro.params.id} tidak ada atau sudah dihapus.`}
				backHref="/surat-keluar/daftar"
				backLabel="Kembali ke daftar nomor surat"
			/>
		) : forbidden ? (
			<div class="mx-auto w-full max-w-3xl px-6 py-6">
				<PageHead title="Edit Nomor Surat" subtitle={detail.no} />

				<div class="alert alert-destructive" role="alert">
					<span class="mt-0.5 shrink-0">
						<Icon name="shield" class="h-4 w-4" />
					</span>
					<div class="flex-1">
						<p class="alert-title">Akses ditolak</p>
						<p class="alert-description">
							Anda tidak berhak mengubah nomor surat ini. Hanya admin atau
							pegawai yang mengambil nomor tersebut yang dapat mengubahnya.
						</p>
					</div>
				</div>
				<a href="/surat-keluar/daftar" class="btn-outline btn-sm mt-5">
					<Icon name="arrow-left" class="h-4 w-4" />
					<span>Kembali ke daftar nomor surat</span>
				</a>
			</div>
		) : (
			<>
				<PageHead title="Edit Nomor Surat" subtitle={detail.no} />

				<div class="mx-auto w-full max-w-3xl px-6 py-5">
					{feedback?.message && (
						<div class="mb-5">
							<FeedbackAlert
								class=""
								type={feedback.type ?? "error"}
								message={feedback.message}
							/>
						</div>
					)}

					<div class="mb-6 flex flex-wrap items-center justify-between gap-2 rounded-[var(--radius-panel)] border border-[var(--color-line)] bg-[var(--color-surface-muted)] px-4 py-3">
						<div class="min-w-0">
							<p class="text-xs font-medium uppercase tracking-wider text-[var(--color-ink-subtle)]">
								Nomor surat
							</p>
							<p class="truncate font-medium tabular text-[var(--color-ink)]">
								{detail.no}
							</p>
						</div>
						<span class="badge-outline tabular">{badgeNomor}</span>
					</div>

					<form
						method="post"
						action={`/api/surat-keluar/${detail.id}`}
						class="w-full"
					>
						<input type="hidden" name="_method" value="PUT" />

						<NomorFields
							mode="edit"
							pengambil={pengambil}
							penandatangan={penandatangan}
							klasifikasi={klasifikasi}
							nilai={nilai}
							errors={feedback?.errors ?? null}
						/>

						<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
							<Field
								label="Tanggal Surat"
								name="tanggal"
								required
								error={feedback?.errors?.tanggal}
							>
								<input
									class="input"
									type="date"
									id="tanggal"
									name="tanggal"
									value={tanggalValue}
									aria-invalid={feedback?.errors?.tanggal ? "true" : undefined}
									aria-describedby={
										feedback?.errors?.tanggal ? "tanggal-error" : undefined
									}
									required
								/>
							</Field>
						</div>

						<div class="separator" />

						<div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end">
							<a
								href={`/surat-keluar/daftar?tahun=${tahun}`}
								class="btn-outline"
							>
								<Icon name="arrow-left" class="h-4 w-4" />
								<span>Batal</span>
							</a>
							<button type="submit" class="btn-primary">
								<Icon name="check" class="h-4 w-4" />
								<span>Simpan Perubahan</span>
							</button>
						</div>
					</form>
				</div>
			</>
		)
	}
</AppShell>
