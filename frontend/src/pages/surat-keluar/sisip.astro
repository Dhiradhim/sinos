---
/**
 * Sisip Nomor Surat.
 *
 * Sumber: sinos/application/views/surat_keluar/sisip.php +
 * `_form_nomor_fields.php` + Surat_keluar::sisip()/sisip_simpan().
 * Aksi: `POST /api/surat-keluar/sisip`.
 *
 * `Tanggal` adalah field backdate: `max` = hari ini (sama dengan
 * `$tanggal_hari_ini` pada controller CI3). Guard klien di bawah hanya
 * menghindari round-trip; API tetap menegakkan aturan yang sama dengan pesan
 * identik.
 *
 * Setelah 201, action route menyimpan ringkasan `meta` (last_no_urut_sebelum,
 * nomor_terpakai, huruf_terpakai) di cookie umpan balik sekali pakai; halaman
 * menampilkannya sebagai `.alert-success` — jejak audit yang di CI3 hanya
 * terlihat lewat flashdata "Nomor surat disisipkan: …".
 */
import AppShell from "../../layouts/AppShell.astro";
import PageHead from "../../components/PageHead.astro";
import NomorFields from "../../components/NomorFields.astro";
import FeedbackAlert from "../../components/FeedbackAlert.astro";
import Icon from "../../components/Icon.astro";
import { requireUser } from "../../lib/auth";
import { apiFetch } from "../../lib/api";
import { getSession } from "../../lib/session";
import { takeFormFeedback } from "../../lib/formFeedback";
import { currentYear, todayISO } from "../../lib/format";
import type {
	Klasifikasi,
	PenandatanganGrup,
	Pengambil,
} from "../../lib/suratKeluar";

const auth = await requireUser(Astro);
if (auth.redirect) return auth.redirect;
const user = auth.user;
const token = getSession(Astro.cookies);

const tahun = currentYear();

const [pengambilRes, penandatanganRes, klasifikasiRes] = await Promise.all([
	apiFetch<Pengambil[]>("/master/pengambil", { token }),
	apiFetch<PenandatanganGrup[]>("/master/penandatangan", { token }),
	apiFetch<Klasifikasi[]>("/master/klasifikasi", { token }),
]);

const pengambil = pengambilRes.data ?? [];
const penandatangan = penandatanganRes.data ?? [];
const klasifikasi = klasifikasiRes.data ?? [];

const dashboard = await apiFetch<{ disposisi_belum_dibaca: number }>(
	"/dashboard",
	{ token, query: { tahun } },
);
const disposisiCount = dashboard.data?.disposisi_belum_dibaca ?? 0;

const feedback = takeFormFeedback(Astro.cookies, Astro.url.pathname);

/**
 * Tanggal hari ini menurut zona waktu aplikasi (UTC+8 / WITA). Dihitung sekali
 * di sini agar `max` dan nilai awal selalu sama. Memakai helper `todayISO()`,
 * bukan `new Date()` mentah, agar hasilnya tidak bergantung pada zona mesin.
 */
const today = todayISO();

const nilaiTanggal =
	feedback?.values && typeof feedback.values.tanggal === "string"
		? feedback.values.tanggal
		: today;

/**
 * Ringkasan audit sisip. HANYA terisi bila route action mengalihkan kembali
 * ke halaman ini (kasus gagal). Pada 201 route mengalihkan ke
 * `/surat-keluar/daftar-semua`, jadi popup rincian nomor dirender di sana —
 * bukan di sini.
 */
const audit = feedback?.result ?? null;
---

<AppShell
	title="Sisip Nomor Surat"
	user={user}
	disposisiCount={disposisiCount}
	tahun={tahun}
	topbarTitle={false}
>
	<PageHead
		title="Sisip Nomor Surat"
		subtitle="Sisipkan nomor surat pada tanggal mundur."
	/>

	<div class="mx-auto w-full max-w-3xl px-6 py-5">
		{
			audit && (
				<div class="alert alert-success mb-5" role="status">
					<span class="mt-0.5 shrink-0">
						<Icon name="circle-check" class="h-4 w-4" />
					</span>
					<div class="flex-1">
						<p class="alert-title">Nomor surat disisipkan</p>
						<p class="alert-description">
							{feedback?.message ?? `Nomor surat disisipkan: ${audit.nomor}`}
						</p>
						<dl class="mt-2 grid grid-cols-1 gap-x-4 gap-y-1 text-xs sm:grid-cols-3">
							<div>
								<dt class="font-medium uppercase tracking-wide">
									Nomor urut sebelumnya
								</dt>
								<dd class="tabular">{audit.last_no_urut_sebelum}</dd>
							</div>
							<div>
								<dt class="font-medium uppercase tracking-wide">
									Nomor terpakai
								</dt>
								<dd class="tabular">{audit.nomor_terpakai}</dd>
							</div>
							<div>
								<dt class="font-medium uppercase tracking-wide">
									Huruf terpakai
								</dt>
								<dd class="tabular">{audit.huruf_terpakai}</dd>
							</div>
						</dl>
					</div>
				</div>
			)
		}

		{
			feedback?.message && !audit && (
				<div class="mb-5">
					<FeedbackAlert
						class=""
						type={feedback.type ?? "error"}
						message={feedback.message}
					/>
				</div>
			)
		}

		<form
			method="post"
			action="/api/surat-keluar/sisip"
			class="w-full"
			data-sisip-form
			data-today={today}
		>
			<NomorFields
				mode="sisip"
				pengambil={pengambil}
				penandatangan={penandatangan}
				klasifikasi={klasifikasi}
				nilai={feedback?.values ?? null}
				errors={feedback?.errors ?? null}
				tanggalField={{ max: today, value: nilaiTanggal }}
			/>

			<p
				class="field-error hidden"
				id="tanggal-mundur-error"
				role="alert"
				data-sisip-error
			>
				Sisip nomor hanya untuk tanggal mundur (tidak boleh melebihi hari ini).
			</p>

			<div class="separator"></div>

			<div
				class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between"
			>
				<p class="text-xs text-[var(--color-ink-subtle)]">
					Huruf ditambahkan otomatis bila nomor pada tanggal tersebut sudah
					terpakai.
				</p>
				<div class="flex flex-wrap items-center gap-2 sm:justify-end">
					<button type="reset" class="btn-ghost">Ulang</button>
					<a href={`/surat-keluar/daftar?tahun=${tahun}`} class="btn-outline">
						Batal
					</a>
					<button type="submit" class="btn-primary">Sisip Nomor</button>
				</div>
			</div>
		</form>
	</div>
</AppShell>

<script>
	/**
	 * Guard backdate di klien.
	 *
	 * Server (api/surat_keluar::sisip()) menolak tanggal > hari ini dengan pesan
	 * yang sama; guard ini hanya menghindari satu round-trip. Perbandingan
	 * memakai string `YYYY-MM-DD` sehingga tidak bergantung pada zona waktu
	 * browser (format date input selalu urut secara leksikografis).
	 */
	const form = document.querySelector<HTMLFormElement>("[data-sisip-form]");
	const input = form?.querySelector<HTMLInputElement>('input[name="tanggal"]');
	const error = document.querySelector<HTMLElement>("[data-sisip-error]");
	const today = form?.dataset.today ?? "";

	const validate = (): boolean => {
		if (!input || !error) return true;
		const invalid = today !== "" && input.value !== "" && input.value >= today;
		error.classList.toggle("hidden", !invalid);
		input.setAttribute("aria-invalid", invalid ? "true" : "false");
		return !invalid;
	};

	input?.addEventListener("input", () => {
		if (!error?.classList.contains("hidden")) validate();
	});

	form?.addEventListener("submit", (event) => {
		if (!validate()) {
			event.preventDefault();
			input?.focus();
		}
	});
</script>
