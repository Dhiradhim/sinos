---
/**
 * Select.astro — Preline advanced select.
 *
 * Port 1:1 dari `hs_select_attr()` di
 * sinos/application/helpers/sinos_helper.php:248. JSON `data-hs-select`
 * identik dengan yang dihasilkan PHP: kelas toggle, dropdown, opsi, template,
 * markup panah, dan panel pencarian semuanya disalin apa adanya agar
 * perilakunya sama dengan view CI3.
 *
 * JANGAN diturunkan menjadi <select> native — panel pencarian hilang dan
 * `aria-[invalid]` tidak lagi dipakai Preline.
 *
 *   <Select name="kode" id="kode" placeholder="Pilih salah satu"
 *           searchPlaceholder="Cari kode / nama klasifikasi…"
 *           options={klasifikasi.map(k => ({ value: k.kode, label: `${k.kode} - ${k.nama}` }))}
 *           value={row?.kode} required />
 *
 * `emptyOption` menambahkan opsi kosong (untuk filter "Semua"). Opsi kosong
 * TIDAK dibuat oleh komponen bila `emptyLabel` tidak diisi; pemanggil dapat
 * menyisipkan opsinya sendiri lewat prop `options` dengan value "".
 *
 * PLACEHOLDER: komponen SELALU merender satu opsi `value=""` ber-atribut
 * `hidden` sebagai opsi terpilih awal. Akibatnya:
 *   - tidak ada opsi database yang otomatis terpilih (dulu opsi pertama
 *     langsung tampil sebagai nilai terpilih);
 *   - Preline tidak merender opsi kosong sebagai baris dropdown
 *     (`optionAllowEmptyOption` mati), sehingga saat dropdown diklik hanya
 *     opsi dari database yang terlihat;
 *   - toggle tetap menampilkan `placeholder` selama belum ada pilihan.
 *
 * Karena Preline menyembunyikan <select> asli (`display:none`), atribut
 * `required` bawaan browser tidak dapat memfokuskan kontrol dan submit
 * berhenti tanpa pesan. Karena itu `required` diterjemahkan menjadi
 * `data-select-required` + `aria-required`; penegakannya ada di skrip
 * AppShell.astro (satu salinan untuk seluruh halaman).
 */
interface Option {
	value: string;
	label: string;
	disabled?: boolean;
}

interface Props {
	name: string;
	id?: string;
	placeholder?: string;
	/** Kosong = tanpa panel pencarian (sama dengan argumen ke-2 helper). */
	searchPlaceholder?: string;
	options: Option[];
	value?: string | number | null;
	required?: boolean;
	/** Menambah opsi kosong "Semua" di paling atas. */
	emptyOption?: boolean;
	emptyLabel?: string;
	disabled?: boolean;
	/** ID elemen bantuan/error untuk aria-describedby. */
	describedBy?: string;
	/** Menandai select tidak valid (merah) saat 422. */
	invalid?: boolean;
	class?: string;
}

const {
	name,
	id = name,
	placeholder = "Pilih…",
	searchPlaceholder = "Cari…",
	options,
	value = "",
	required = false,
	emptyOption = false,
	emptyLabel = "",
	disabled = false,
	describedBy,
	invalid = false,
	class: className = "",
} = Astro.props;

const current = value === null || value === undefined ? "" : String(value);

/**
 * Pesan galat `required`. Placeholder yang sudah berbunyi "Pilih …" dipakai
 * apa adanya agar tidak menjadi "Pilih pilih …", dan tanda titik tidak
 * digandakan bila placeholder sudah diakhiri "…" atau ".".
 */
const kalimat = /^pilih\b/i.test(placeholder)
	? placeholder
	: `Pilih ${placeholder.toLowerCase()}`;
const requiredMessage = /[.…]$/.test(kalimat) ? kalimat : `${kalimat}.`;

/**
 * Konfigurasi JSON Preline. Urutan kunci mengikuti hs_select_attr() agar
 * keluaran HTML dapat dibandingkan langsung dengan versi CI3.
 */
const config: Record<string, unknown> = {
	placeholder,
	toggleClasses:
		"hs-select-toggle relative py-2 ps-3 pe-9 flex gap-x-2 text-nowrap w-full cursor-pointer bg-white border border-gray-300 rounded-lg text-start text-sm text-gray-900 focus:outline-none focus:border-brand-900 focus:ring-1 focus:ring-brand-900 aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500 disabled:pointer-events-none disabled:opacity-50",
	dropdownClasses:
		"mt-2 max-h-72 pb-1 px-1 space-y-0.5 z-50 w-full bg-white border border-gray-200 rounded-lg overflow-hidden overflow-y-auto shadow-lg",
	optionClasses:
		"py-2 px-3 w-full text-sm text-gray-800 cursor-pointer rounded-md hover:bg-gray-100 focus:outline-none focus:bg-gray-100",
	optionTemplate:
		'<div class="flex items-center justify-between"><span data-title></span><span class="hidden hs-selected:block"><svg class="shrink-0 size-4 text-brand-900" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span></div>',
	extraMarkup:
		'<button type="button" class="absolute top-1/2 end-3 -translate-y-1/2" aria-label="Buka pilihan"><svg class="shrink-0 size-3.5 text-gray-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg></button>',
};

if (searchPlaceholder !== "" && searchPlaceholder !== null) {
	config.hasSearch = true;
	config.searchPlaceholder = searchPlaceholder;
	config.searchWrapperClasses =
		"bg-white p-2 sticky top-0 z-10 border-b border-gray-100";
	config.searchClasses =
		"block w-full text-sm border border-gray-300 rounded-lg py-2 px-3 focus:border-brand-900 focus:outline-none focus:ring-1 focus:ring-brand-900";
	config.searchNoResultText = "Tidak ditemukan";
	config.searchNoResultClasses = "px-3 py-2 text-sm text-gray-500";
}

if (emptyOption) {
	config.optionAllowEmptyOption = true;
}

// JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE seperti helper PHP.
const attrJson = JSON.stringify(config)
	.replace(/\\\//g, "/")
	.replace(/\\u([0-9a-fA-F]{4})/g, (_m, hex) =>
		String.fromCharCode(parseInt(hex, 16)),
	);
---

<select
	id={id}
	name={name}
	class:list={["select", className]}
	disabled={disabled}
	aria-required={required ? "true" : undefined}
	aria-invalid={invalid ? "true" : undefined}
	aria-describedby={describedBy}
	data-select-required={required ? "true" : undefined}
	data-select-required-message={required ? requiredMessage : undefined}
	data-hs-select={attrJson}
>
	{
		/*
    Placeholder. `hidden` menjaga opsi ini tidak muncul sebagai baris
    dropdown (Preline juga menyaring opsi ber-value kosong), tetapi teksnya
    dipakai sebagai judul toggle selama belum ada pilihan.
  */
	}
	{
		emptyOption ? (
			<option value="" selected={current === ""}>
				{emptyLabel}
			</option>
		) : (
			<option value="" hidden selected={current === ""}>
				{placeholder}
			</option>
		)
	}
	{
		options.map((opt) => (
			<option
				value={opt.value}
				disabled={opt.disabled}
				selected={opt.value === current}
			>
				{opt.label}
			</option>
		))
	}
</select>
