---
/**
 * DisposisiModal.astro — Preline overlay "Kirim / Teruskan Disposisi".
 *
 * Diekstrak dari sinos/application/views/disposisi/detail.php:118-214 (overlay +
 * skrip `bukaDisposisi()`), lalu dipakai bersama oleh:
 *   - src/pages/disposisi/index.astro   (judul "Kirim Disposisi")
 *   - src/pages/disposisi/detail/[id].astro (judul "Teruskan Disposisi")
 *
 * Kontrak:
 *   - pemicu: elemen apa pun dengan `data-disposisi-open="{surmas_id}"`
 *     (index memakai `aksi.can_forward` + `surmas_id`; detail memakai tombol
 *     "Teruskan Disposisi" dengan `surmas_id` disposisi tersebut).
 *   - isi form: `GET /api/disposisi/form/{surmas_id}` (proxy BFF, JSON).
 *   - kirim: `POST /api/disposisi` (proxy BFF) lalu `location.reload()`.
 *
 * Kenapa form dirakit di klien dan bukan dirender Astro: data penerima,
 * riwayat, dan instruksi baru diketahui setelah modal dibuka. Semua teks
 * Bahasa Indonesia disalin dari `disposisi/_form_ajax.php`, termasuk
 * "Memuat…", "Pilih Penerima", "Hanya menampilkan user aktif. Pilih satu
 * penerima.", dan "Gagal memuat form disposisi.".
 *
 * Token Bearer tidak pernah sampai ke browser: seluruh fetch menuju route
 * Astro yang membaca cookie httpOnly.
 */
import Icon from "./Icon.astro";

interface Props {
  /** Judul overlay. Index: "Kirim Disposisi"; detail: "Teruskan Disposisi". */
  title?: string;
}

const { title = "Kirim Disposisi" } = Astro.props;
---

<div
  id="modalDisposisi"
  class="hs-overlay pointer-events-none fixed inset-0 z-[80] hidden size-full overflow-y-auto overflow-x-hidden"
  data-hs-overlay-options='{"backdropClasses":"hs-overlay-backdrop transition duration fixed inset-0 bg-[rgb(11_27_58_/_0.45)]"}'
  role="dialog"
  aria-modal="true"
  aria-labelledby="disposisiTitle"
  tabindex="-1"
>
  <div
    class="pointer-events-none m-3 mt-0 flex min-h-[calc(100%-1.5rem)] items-start opacity-0 transition-all duration-300 ease-out sm:mx-auto sm:w-full sm:max-w-2xl hs-overlay-open:mt-7 hs-overlay-open:opacity-100"
  >
    <div
      class="pointer-events-auto flex w-full flex-col rounded-[var(--radius-panel)] border border-[var(--color-line)] bg-[var(--color-canvas)] shadow-[var(--shadow-panel)]"
    >
      <div
        class="flex items-center justify-between border-b border-[var(--color-line)] px-5 py-3"
      >
        <h3
          id="disposisiTitle"
          class="flex items-center gap-2 text-sm font-semibold text-[var(--color-ink)]"
        >
          <span
            class="flex h-8 w-8 items-center justify-center rounded-[var(--radius-control)] bg-[var(--color-brand-50)] text-[var(--color-brand-900)]"
          >
            <Icon name="send" class="h-4 w-4" />
          </span>
          {title}
        </h3>
        <button
          type="button"
          class="btn-icon"
          data-disposisi-close
          aria-label="Tutup"
        >
          <Icon name="x" class="h-4 w-4" />
        </button>
      </div>
      <div id="modalDisposisiBody" class="px-5 py-4">
        <p class="py-8 text-center text-sm text-[var(--color-ink-subtle)]">
          Memuat…
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  /**
   * Modal disposisi.
   *
   * Form diambil dari proxy BFF, dirender sebagai HTML di klien, lalu Preline
   * diinisialisasi ulang (`HSStaticMethods.autoInit()`) agar select hasil
   * suntikan aktif — pola yang sama dipakai daftar surat masuk.
   */
  const MODAL = document.getElementById("modalDisposisi");
  const BODY = document.getElementById("modalDisposisiBody");

  type Penerima = { id: number; label: string };
  type Instruksi = { value: string; label: string };
  type Riwayat = {
    kepada: string;
    kategori: string;
    tanggal: { teks: string };
  };
  type FormPayload = {
    surat: {
      id: number;
      no_surat: string;
      no_agenda: string;
      tgl_surat: { teks: string };
      pengirim: string;
      perihal: string;
    };
    penerima: Penerima[];
    instruksi: Instruksi[];
    riwayat: Riwayat[];
  };

  /** JSON untuk `data-hs-select`, identik dengan hs_select_attr(). */
  function hsSelectAttr(placeholder: string, search: string): string {
    const cfg: Record<string, unknown> = {
      placeholder,
      toggleClasses:
        "hs-select-toggle relative py-2 ps-3 pe-9 flex gap-x-2 text-nowrap w-full cursor-pointer bg-white border border-gray-300 rounded-lg text-start text-sm text-gray-900 focus:outline-none focus:border-brand-900 focus:ring-1 focus:ring-brand-900 aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-red-500 disabled:pointer-events-none disabled:opacity-50",
      dropdownClasses:
        "mt-2 max-h-72 pb-1 px-1 space-y-0.5 z-50 w-full bg-white border border-gray-200 rounded-lg overflow-hidden overflow-y-auto shadow-lg",
      optionClasses:
        "py-2 px-3 w-full text-sm text-gray-800 cursor-pointer rounded-md hover:bg-gray-100 focus:outline-none focus:bg-gray-100",
      optionTemplate:
        '<div class="flex items-center justify-between"><span data-title></span><span class="hidden hs-selected:block"><svg class="shrink-0 size-4 text-brand-900" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span></div>',
      extraMarkup:
        '<button type="button" class="absolute top-1/2 end-3 -translate-y-1/2" aria-label="Buka pilihan"><svg class="shrink-0 size-3.5 text-gray-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg></button>',
      hasSearch: true,
      searchPlaceholder: search,
      searchWrapperClasses:
        "bg-white p-2 sticky top-0 z-10 border-b border-gray-100",
      searchClasses:
        "block w-full text-sm border border-gray-300 rounded-lg py-2 px-3 focus:border-brand-900 focus:outline-none focus:ring-1 focus:ring-brand-900",
      searchNoResultText: "Tidak ditemukan",
      searchNoResultClasses: "px-3 py-2 text-sm text-gray-500",
      optionAllowEmptyOption: true,
    };
    return JSON.stringify(cfg).replace(/\\\//g, "/");
  }

  /**
   * Escape HTML untuk markup yang dirakit sebagai string. Entitas dibangun
   * dari kode karakter agar tidak bergantung pada encoding berkas.
   */
  const AMP = String.fromCharCode(38);
  const LT = String.fromCharCode(60);
  const GT = String.fromCharCode(62);
  const QUOT = String.fromCharCode(34);

  function esc(value: unknown): string {
    return String(value ?? "")
      .split(AMP)
      .join(AMP + "amp;")
      .split(LT)
      .join(AMP + "lt;")
      .split(GT)
      .join(AMP + "gt;")
      .split(QUOT)
      .join(AMP + "quot;");
  }

  function openModal() {
    const HS = (window as any).HSOverlay;
    if (HS && typeof HS.open === "function") {
      HS.open(MODAL);
    } else {
      MODAL?.classList.remove("hidden");
      MODAL?.classList.add("open");
    }
  }

  function closeModal() {
    const HS = (window as any).HSOverlay;
    if (HS && typeof HS.close === "function") {
      HS.close(MODAL);
    } else {
      MODAL?.classList.add("hidden");
      MODAL?.classList.remove("open");
    }
    if (BODY) BODY.innerHTML = "";
  }

  function renderForm(data: FormPayload): string {
    const opsiPenerima = data.penerima
      .map((u) => `<option value="${u.id}">${esc(u.label)}</option>`)
      .join("");
    const opsiInstruksi = data.instruksi
      .map((i) => `<option value="${esc(i.value)}">${esc(i.label)}</option>`)
      .join("");

    // Riwayat: blok yang sama dengan `_form_ajax.php:68-83`.
    const riwayat =
      data.riwayat.length > 0
        ? `
        <div>
          <p class="fieldset-legend">Riwayat Disposisi</p>
          <ul class="max-h-32 space-y-1 overflow-y-auto text-xs">
            ${data.riwayat
              .map(
                (rw) => `
              <li class="flex items-center justify-between gap-2 rounded-[var(--radius-control)] border border-[var(--color-line)] bg-[var(--color-surface-muted)] px-3 py-1.5">
                <span class="min-w-0">
                  <span class="font-medium text-[var(--color-ink)]">${esc(rw.kepada)}</span>
                  <span class="text-[var(--color-ink-subtle)]">(${esc(rw.kategori)})</span>
                </span>
                <span class="shrink-0 tabular text-[var(--color-ink-subtle)]">${esc(rw.tanggal?.teks ?? "")}</span>
              </li>`,
              )
              .join("")}
          </ul>
        </div>`
        : "";

    return `
      <form id="formDisposisi" class="space-y-4" novalidate>
        <input type="hidden" name="surmas_id" value="${data.surat.id}">

        <div class="rounded-[var(--radius-control)] border border-[var(--color-line)] bg-[var(--color-surface-muted)] p-4">
          <dl class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
            <div>
              <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">No. Surat</dt>
              <dd class="text-sm font-medium text-[var(--color-ink)]">${esc(data.surat.no_surat)}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">No. Agenda</dt>
              <dd class="text-sm font-medium tabular text-[var(--color-ink)]">${esc(data.surat.no_agenda)}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Tanggal</dt>
              <dd class="text-sm font-medium text-[var(--color-ink)]">${esc(data.surat.tgl_surat?.teks ?? "")}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Pengirim</dt>
              <dd class="text-sm font-medium text-[var(--color-ink)]">${esc(data.surat.pengirim)}</dd>
            </div>
            <div class="sm:col-span-2">
              <dt class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Perihal</dt>
              <dd class="text-sm font-medium text-[var(--color-ink)]">${esc(data.surat.perihal)}</dd>
            </div>
          </dl>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="label" for="target">Disposisi Kepada <span class="text-[var(--color-danger)]">*</span></label>
            <select class="select" id="target" name="target" required data-hs-select='${hsSelectAttr("Pilih penerima", "Cari nama penerima…")}'>
              <option value="">Pilih Penerima</option>
              ${opsiPenerima}
              <option value="Arsip">Arsip</option>
            </select>
            <p class="mt-1.5 text-xs text-[var(--color-ink-subtle)]">Hanya menampilkan user aktif. Pilih satu penerima.</p>
          </div>

          <div>
            <label class="label" for="instruksi">Instruksi</label>
            <select class="select" id="instruksi" name="instruksi">
              <option value="">Pilih Instruksi</option>
              ${opsiInstruksi}
            </select>
          </div>

          <div>
            <label class="label" for="catatan">Catatan</label>
            <textarea class="textarea" id="catatan" name="catatan" rows="4" placeholder="Catatan (opsional)"></textarea>
          </div>
        </div>

        ${riwayat}

        <div id="disposisiError" class="field-error hidden" role="alert"></div>

        <div class="flex justify-end gap-2 border-t border-[var(--color-line)] pt-4">
          <button type="button" class="btn-outline" data-disposisi-close>Batal</button>
          <button type="submit" class="btn-primary">
            <span>Kirim Disposisi</span>
          </button>
        </div>
      </form>
    `;
  }

  function showError(message: string) {
    const box = document.getElementById("disposisiError");
    if (!box) return;
    box.textContent = message;
    box.classList.remove("hidden");
  }

  async function bukaDisposisi(surmasId: number) {
    if (!BODY) return;
    BODY.innerHTML =
      '<p class="py-8 text-center text-sm text-[var(--color-ink-subtle)]">Memuat…</p>';
    openModal();

    try {
      const response = await fetch(`/api/disposisi/form/${surmasId}`, {
        headers: { Accept: "application/json" },
      });

      if (!response.ok) {
        const payload = await response.json().catch(() => null);
        BODY.innerHTML = `<p class="py-8 text-center text-sm text-[var(--color-danger)]">${esc(
          payload?.error?.message ?? "Gagal memuat form disposisi.",
        )}</p>`;
        return;
      }

      const payload = await response.json();
      BODY.innerHTML = renderForm(payload.data as FormPayload);

      // Preline perlu diinisialisasi ulang untuk markup hasil innerHTML.
      const HS = (window as any).HSStaticMethods;
      if (HS && typeof HS.autoInit === "function") HS.autoInit();

      BODY.querySelectorAll("[data-disposisi-close]").forEach((el) => {
        el.addEventListener("click", closeModal);
      });

      const form = BODY.querySelector<HTMLFormElement>("#formDisposisi");
      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const select = form.querySelector<HTMLSelectElement>(
          'select[name="target"]',
        );
        // Pesan sama dengan Disposisi::kirim() di CI3.
        if (!select || !select.value) {
          showError("Pilih penerima disposisi.");
          return;
        }

        const submitBtn = form.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        if (submitBtn) submitBtn.disabled = true;

        try {
          const response = await fetch("/api/disposisi", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              surmas_id: Number(
                form.querySelector<HTMLInputElement>('input[name="surmas_id"]')
                  ?.value ?? surmasId,
              ),
              target: select.value,
              instruksi:
                form.querySelector<HTMLSelectElement>(
                  'select[name="instruksi"]',
                )?.value ?? "",
              catatan:
                form.querySelector<HTMLTextAreaElement>(
                  'textarea[name="catatan"]',
                )?.value ?? "",
            }),
          });

          const payload = await response.json().catch(() => null);

          if (!response.ok) {
            showError(payload?.error?.message ?? "Disposisi gagal dikirim.");
            if (submitBtn) submitBtn.disabled = false;
            return;
          }

          closeModal();
          window.location.reload();
        } catch {
          showError("Disposisi gagal dikirim. Periksa koneksi.");
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    } catch {
      BODY.innerHTML =
        '<p class="py-8 text-center text-sm text-[var(--color-danger)]">Gagal memuat form disposisi.</p>';
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-disposisi-open]")
    .forEach((el) => {
      el.addEventListener("click", () => {
        const id = Number(el.dataset.disposisiOpen);
        if (id > 0) void bukaDisposisi(id);
      });
    });
</script>
