# SINOS - contoh konfigurasi environment.
# Salin menjadi .env lalu sesuaikan.
#
# PEMISAHAN DATABASE:
#   Aplikasi ini PEMILIK schema `sinos` (surat menyurat).
#   Data pegawai ada di schema `pegawai_db` dan hanya DIBACA.
#   Kolom `pass` tidak termasuk grant SELECT untuk SINOS.
#   Buat user MySQL khusus, jangan pakai root.

DB_HOSTNAME=localhost
DB_USERNAME=sinos_app
DB_PASSWORD=GANTI_PASSWORD_SINOS_ACAK_32_KARAKTER
DB_DATABASE=sinos

# SSO (sinos sebagai klien gateway)
SSO_ENABLED=1
SSO_FORCE=0
SSO_GATEWAY=http://localhost/sso/
SSO_APP_ID=sinos
SSO_APP_SECRET=GANTI_SECRET_ACAK_PANJANG_SINOS
SSO_CALLBACK=http://localhost/sinos/sso/callback
SSO_TIMEOUT=5

# FASE 7: base URL frontend Astro (sinos-web). Dipakai sebagai tujuan
# redirect pengganti rute HTML `login`/`dashboard` yang sudah dihapus.
# Tanpa "/" di akhir.
SINOS_WEB_URL=http://localhost:4321

# API HEADLESS - kunci HMAC token /api/v1/ (Fase 0 migrasi Astro).
# WAJIB diganti dengan nilai acak panjang sebelum dipakai di produksi.
# Contoh membuat nilai: php -r "echo bin2hex(random_bytes(32));"
# Bila kosong/tidak ada, aplikasi memakai kunci turunan base_url + ENVIRONMENT
# yang TIDAK rahasia (hanya untuk pengembangan) dan menulis peringatan ke log.
API_SECRET=GANTI_API_SECRET_ACAK_PANJANG_SINOS
